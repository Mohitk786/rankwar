# Plain Postgres: same value for both. Supabase/PgBouncer-style hosts: DATABASE_URL
# is the pooled connection (used by the running app), DIRECT_URL is the direct/session
# connection (used only by Prisma CLI for migrations — pooled transaction-mode
# connections don't support the advisory locks migrations need).
DATABASE_URL="postgresql://user:password@localhost:5432/rankwar?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/rankwar?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="RankWar"

# Stripe test-mode keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# https://dashboard.stripe.com/test/webhooks or `stripe listen --print-secret`
STRIPE_WEBHOOK_SECRET=""

ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-too"

# Bearer token required by /api/cron/close-daily
CRON_SECRET="change-me-as-well"
